# Keeps editors (Visual Studio, VS Code, Unity's IDEs) on the line endings .gitattributes sets. Nothing here changes how code is built or formatted.
root = true

[*]
end_of_line = lf

[*.{bat,cmd,sln}]
end_of_line = crlf

# Windows PowerShell 5.1 (the one every Windows ships) reads a script without a BOM as ANSI, which breaks a string holding a dash or an umlaut
[*.ps1]
charset = utf-8-bom
