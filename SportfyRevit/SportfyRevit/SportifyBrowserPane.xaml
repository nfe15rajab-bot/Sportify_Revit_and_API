<UserControl x:Class="SportfyRevit.SportifyBrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid x:Name="Host">
        <wv2:WebView2 x:Name="Browser" />
        <StackPanel x:Name="ErrorPanel" Margin="16" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       Foreground="Firebrick" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="OpenInBrowserButton" Content="Open the Sportify app in your browser" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="RetryButton" Content="Try again" Padding="12,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
