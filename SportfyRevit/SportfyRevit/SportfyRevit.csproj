<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed for the OpenSportifyApp dockable pane's XAML UserControl
         (SportifyBrowserPane) — nothing else in this project uses WPF. -->
    <UseWPF>true</UseWPF>
    <!-- LoadFamiliesCommand's multi-select file dialog. WinForms' OpenFileDialog
         is used rather than WPF's because it takes an owner window: a modal shown
         from an add-in with no owner leaves Revit's main window disabled after it
         closes — the window stops accepting input while the process still reports
         itself responsive and idle, which reads as a total freeze. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Revit 2025 add-ins target net8.0-windows; Revit itself supplies
         RevitAPI(UI).dll at load time, so these are compile-only references
         (Private=false) and must never end up copied into bin/. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- QuestPDF ships its native rendering engine per-RID under runtimes/
         (no separate SkiaSharp package reference needed, unlike older
         versions) — without an explicit RuntimeIdentifier, the build can't
         pick a variant and silently skips QuestPDF.dll itself, not just the
         native asset. WebView2 doesn't need this (it ships its own
         MSBuild targets that copy its native loader unconditionally). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Without this, a resolved PackageReference's DLL can appear correctly
         in deps.json (proving resolution worked) and still never get copied
         to bin/ — a known gap for a "library hosted by another process"
         project like this one, which isn't run standalone the way a normal
         .exe project (where this defaults on) is. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- The actual complete fix for a plugin/add-in project: this is
         Microsoft's documented property for exactly this "class library
         loaded directly by a host app, not referenced by another project"
         case — CopyLocalLockFileAssemblies alone got QuestPDF.dll copied
         but not its runtimes/win-x64/native/*.dll (QuestPdfSkia.dll,
         qpdf.dll), which QuestPDF needs at runtime to actually render. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <QuestPdfVersion>2026.9.0</QuestPdfVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="QuestPDF" Version="$(QuestPdfVersion)" />
  </ItemGroup>

  <!-- QuestPDF's runtimes/win-x64/native/*.dll (its Skia-based rendering
       engine — QuestPdfSkia.dll, qpdf.dll) never lands in the build output
       through the normal NuGet asset-selection path for this project, even
       with RuntimeIdentifier + CopyLocalLockFileAssemblies +
       EnableDynamicLoading all set (tried all three above; none did it,
       alone or together — unlike WebView2Loader.dll, which copies fine on
       its own via WebView2's own MSBuild targets). Copying directly from
       the NuGet cache is the guaranteed fix. Keep QuestPdfVersion above in
       sync with this if the package is ever upgraded. -->
  <ItemGroup>
    <QuestPdfNativeFiles Include="$(NuGetPackageRoot)questpdf\$(QuestPdfVersion)\runtimes\win-x64\native\*.dll" />
    <None Include="@(QuestPdfNativeFiles)">
      <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- UseWindowsForms adds a global "using System.Windows.Forms", which collides
       with Autodesk.Revit.ApplicationServices.Application and WPF's UserControl.
       Only one file needs WinForms and it fully qualifies the two types it uses,
       so drop the global import and keep the assembly reference. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- The manifest Revit actually reads to discover this add-in. Copied into
       $(OutDir) so DeployToRevitAddins below sweeps it into the Addins folder
       with the rest of the output — otherwise the DLL deploys but Revit never
       learns it's there, and the ribbon tab silently fails to appear. -->
  <ItemGroup>
    <None Include="SportfyRevit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The wind and erosion model is plain C# with no Unity types, so the add-in compiles the very same
       source file the Unity project runs: the analysis needs no Unity installed, and the two can never
       drift apart. (Sportify.Simulation lives next to this project in the same repository.) -->
  <ItemGroup>
    <Compile Include="..\..\Sportify.Simulation\Assets\Scripts\Simulation\Wind\WindAnalysisCore.cs" Link="Wind\WindAnalysisCore.cs" />
    <Compile Include="..\..\Sportify.Simulation\Assets\Scripts\Simulation\Water\PercolationCore.cs" Link="Water\PercolationCore.cs" />
  </ItemGroup>

  <PropertyGroup>
    <SportifyWebAppDir>$(MSBuildProjectDirectory)\..\..\..\sportfify_goldbeck\</SportifyWebAppDir>
  </PropertyGroup>

  <!-- Bundles the sibling web app's static files (plain HTML/CSS/JS, no
       build step) into $(OutDir)web\, which DeployToRevitAddins below then
       sweeps into the Addins folder alongside everything else — this is
       what lets StaticWebServer.cs serve the app directly with no
       Node.js/npx "serve" dependency, the thing that makes a packaged
       installer actually seamless. Conditioned on the sibling repo really
       being checked out next to this one (true on this dev machine, not
       guaranteed for someone cloning only this repo) — silently skipped
       otherwise, exactly like DeployToRevitAddins skips a machine with no
       Revit Addins folder. -->
  <Target Name="BundleWebApp" AfterTargets="Build" Condition="Exists('$(SportifyWebAppDir)index.html')">
    <ItemGroup>
      <SportifyWebFiles Include="$(SportifyWebAppDir)*.html;$(SportifyWebAppDir)*.css;$(SportifyWebAppDir)*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(SportifyWebFiles)" DestinationFolder="$(OutDir)web\" SkipUnchangedFiles="true" />
  </Target>

  <!-- The .addin manifest under %APPDATA%\Autodesk\Revit\Addins\2025\ points
       at a DLL copy in that same folder, not at bin\ — Revit never reads
       bin\ directly. Without this, a build can succeed while Revit keeps
       loading yesterday's behavior with no error anywhere. Harmless on a
       machine with no such folder: Copy creates it.
       Copies the WHOLE output tree (not just SportfyRevit.dll/.pdb) since
       WebView2 pulls in its own managed DLLs plus a runtimes\<rid>\native\
       WebView2Loader.dll — %(RecursiveDir) preserves that subfolder
       structure at the destination, which is where the native loader
       actually gets probed for. -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build">
    <ItemGroup>
      <RevitAddinFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RevitAddinFiles)" DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\2025\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
