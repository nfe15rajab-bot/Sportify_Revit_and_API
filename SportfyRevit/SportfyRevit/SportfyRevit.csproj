<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed for the OpenSportifyApp dockable pane's XAML UserControl
         (SportifyBrowserPane) — nothing else in this project uses WPF. -->
    <UseWPF>true</UseWPF>
    <!-- LoadFamiliesCommand's multi-select file dialog. WinForms' OpenFileDialog
         is used rather than WPF's because it takes an owner window: a modal shown
         from an add-in with no owner leaves Revit's main window disabled after it
         closes — the window stops accepting input while the process still reports
         itself responsive and idle, which reads as a total freeze. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Revit 2025 add-ins target net8.0-windows; Revit itself supplies
         RevitAPI(UI).dll at load time, so these are compile-only references
         (Private=false) and must never end up copied into bin/. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- UseWindowsForms adds a global "using System.Windows.Forms", which collides
       with Autodesk.Revit.ApplicationServices.Application and WPF's UserControl.
       Only one file needs WinForms and it fully qualifies the two types it uses,
       so drop the global import and keep the assembly reference. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- The manifest Revit actually reads to discover this add-in. Copied into
       $(OutDir) so DeployToRevitAddins below sweeps it into the Addins folder
       with the rest of the output — otherwise the DLL deploys but Revit never
       learns it's there, and the ribbon tab silently fails to appear. -->
  <ItemGroup>
    <None Include="SportfyRevit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <SportifyWebAppDir>$(MSBuildProjectDirectory)\..\..\..\sportfify_goldbeck\</SportifyWebAppDir>
  </PropertyGroup>

  <!-- Bundles the sibling web app's static files (plain HTML/CSS/JS, no
       build step) into $(OutDir)web\, which DeployToRevitAddins below then
       sweeps into the Addins folder alongside everything else — this is
       what lets StaticWebServer.cs serve the app directly with no
       Node.js/npx "serve" dependency, the thing that makes a packaged
       installer actually seamless. Conditioned on the sibling repo really
       being checked out next to this one (true on this dev machine, not
       guaranteed for someone cloning only this repo) — silently skipped
       otherwise, exactly like DeployToRevitAddins skips a machine with no
       Revit Addins folder. -->
  <Target Name="BundleWebApp" AfterTargets="Build" Condition="Exists('$(SportifyWebAppDir)index.html')">
    <ItemGroup>
      <SportifyWebFiles Include="$(SportifyWebAppDir)*.html;$(SportifyWebAppDir)*.css;$(SportifyWebAppDir)*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(SportifyWebFiles)" DestinationFolder="$(OutDir)web\" SkipUnchangedFiles="true" />
  </Target>

  <!-- The .addin manifest under %APPDATA%\Autodesk\Revit\Addins\2025\ points
       at a DLL copy in that same folder, not at bin\ — Revit never reads
       bin\ directly. Without this, a build can succeed while Revit keeps
       loading yesterday's behavior with no error anywhere. Harmless on a
       machine with no such folder: Copy creates it.
       Copies the WHOLE output tree (not just SportfyRevit.dll/.pdb) since
       WebView2 pulls in its own managed DLLs plus a runtimes\<rid>\native\
       WebView2Loader.dll — %(RecursiveDir) preserves that subfolder
       structure at the destination, which is where the native loader
       actually gets probed for. -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build">
    <ItemGroup>
      <RevitAddinFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RevitAddinFiles)" DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\2025\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
