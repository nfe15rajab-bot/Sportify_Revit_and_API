<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Revit 2025 add-ins target net8.0-windows; Revit itself supplies
         RevitAPI(UI).dll at load time, so these are compile-only references
         (Private=false) and must never end up copied into bin/. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The .addin manifest under %APPDATA%\Autodesk\Revit\Addins\2025\ points
       at a DLL copy in that same folder, not at bin\ — Revit never reads
       bin\ directly. Without this, a build can succeed while Revit keeps
       loading yesterday's behavior with no error anywhere. Harmless on a
       machine with no such folder: Copy creates it. -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build">
    <ItemGroup>
      <RevitAddinFiles Include="$(OutDir)SportfyRevit.dll;$(OutDir)SportfyRevit.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RevitAddinFiles)" DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\2025\" />
  </Target>

</Project>
